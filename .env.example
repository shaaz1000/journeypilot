# Required. Free key from https://build.nvidia.com (NVIDIA API Catalog).
NVIDIA_API_KEY=

# Optional overrides (defaults shown).
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# NVIDIA_THINKING=true          # model thinking is captured and logged; false is about 5x faster
# NVIDIA_THINKING_TOKENS=2048   # extra token budget per call for thinking
# NVIDIA_EMBED_MODEL=nvidia/nemotron-3.5-embed-1b   # ranks official-page passages by meaning
# LLM_TIMEOUT_MS=60000

# External MCP server (Kiwi.com public flight search, no key needed).
# KIWI_MCP_URL=https://mcp.kiwi.com
# MCP_TIMEOUT_MS=30000

# Trace logging. Full prompts, tool results and answers are logged by default; secrets and personal
# data are redacted either way. Set LOG_RAW_PAYLOADS=false to keep 300-character previews only.
# LOG_DIR=logs
# LOG_RAW_PAYLOADS=true
# LOG_RETENTION_DAYS=7

# Cloud tracing in Langfuse (https://cloud.langfuse.com). Enabled when both keys are set.
# Use https://us.cloud.langfuse.com for a US-region project.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Web UI (npm start). A random admin token is printed at startup unless this is set.
# ADMIN_TOKEN=
# PORT=3000
