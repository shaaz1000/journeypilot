# Required. Free key from https://build.nvidia.com (NVIDIA API Catalog).
NVIDIA_API_KEY=

# Optional overrides (defaults shown).
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# LLM_TIMEOUT_MS=60000

# External MCP server (Kiwi.com public flight search, no key needed).
# KIWI_MCP_URL=https://mcp.kiwi.com
# MCP_TIMEOUT_MS=45000

# Trace logging. Raw payloads stay off unless explicitly enabled; secrets are redacted either way.
# LOG_DIR=logs
# LOG_RAW_PAYLOADS=false
# LOG_RETENTION_DAYS=7
